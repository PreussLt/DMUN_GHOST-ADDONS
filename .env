# App-Konfiguration (sicher für Git)
APP_HOST=0.0.0.0
APP_PORT=2026
APP_ENV=production

# Datenbank-Pfad im Container
DB_PATH=/data/quiz.db

# CORS: Ghost-Domain(s) kommagetrennt, z.B. https://dmun.de,https://www.dmun.de
# Für lokale Entwicklung: *
CORS_ORIGINS=*

# ---------------------------------------------------------------
# Domain / öffentliche URL des Quiz-Servers
# Diese URL wird von Ghost-Besuchern aufgerufen (Browser-seitig).
# Beispiele:
#   Produktion:   https://quiz.dmun.de
#   Lokal:        http://localhost:5000
#
# Nach einer Änderung Ghost-Snippets neu generieren:
#   python ghost/generate-snippets.py
# ---------------------------------------------------------------
PUBLIC_API_URL=https://quiz.khenselmann.de

# ---------------------------------------------------------------
# Meme-Upload-Schutz
# Leer lassen = jeder darf hochladen (nur für geschlossene Communities!)
# Token setzen = Widget muss data-upload-token="..." tragen
# Beispiel: python -c "import secrets; print(secrets.token_urlsafe(24))"
# ---------------------------------------------------------------
MEME_UPLOAD_TOKEN=
